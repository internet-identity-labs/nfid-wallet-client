{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.js\"; rc=$?; [ $rc -eq 1 ] && exit 2; exit $rc"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash.js\"; rc=$?; [ $rc -eq 1 ] && exit 2; exit $rc"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-bash.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(yarn nx lint*)",
      "Bash(yarn nx test*)",
      "Bash(yarn nx build*)",
      "Bash(yarn nx serve*)",
      "Bash(yarn nx storybook*)",
      "Bash(yarn format*)",
      "Bash(yarn format:check*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(yarn prettier*)"
    ]
  }
}
