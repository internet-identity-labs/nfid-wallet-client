{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": ["scope:ui", "type:library", "layer:presentation"],
  "// targets": "test/storybook targets come from the @nx/jest and @nx/storybook plugins in nx.json",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config packages/ui/eslint.config.js packages/ui"
      }
    },
    "storybook": {
      "options": {
        "port": 4400
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "options": {
        "output-dir": "../../dist/storybook/ui"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    }
  }
}
