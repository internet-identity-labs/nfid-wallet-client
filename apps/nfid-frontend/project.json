{
  "name": "nfid-wallet-client",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nfid-frontend/src",
  "projectType": "application",
  "tags": ["scope:app", "type:application", "layer:app"],
  "// targets": "build/serve come from @nx/webpack/plugin (webpack.config.js), test from @nx/jest/plugin. webpack.config.js reads the configuration name from NX_TASK_TARGET_CONFIGURATION.",
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/nfid-frontend"],
      "configurations": {
        "production": {},
        "example": {}
      }
    },
    "serve": {
      "configurations": {
        "production": {}
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/nfid-frontend/**/*.{ts,tsx,js,jsx}\" --max-warnings 2000"
      }
    }
  }
}
