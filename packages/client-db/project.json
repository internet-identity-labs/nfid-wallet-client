{
  "name": "client-db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client-db/src",
  "projectType": "library",
  "license": "MIT",
  "tags": ["scope:client-db", "type:library", "layer:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/client-db",
        "main": "packages/client-db/src/index.ts",
        "tsConfig": "packages/client-db/tsconfig.lib.json",
        "assets": ["packages/client-db/*.md"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config packages/client-db/eslint.config.js packages/client-db"
      }
    }
  }
}
