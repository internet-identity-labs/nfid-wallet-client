{
  "name": "integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/integration/src",
  "projectType": "library",
  "tags": ["scope:integration", "type:library", "layer:domain"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/integration",
        "main": "packages/integration/src/index.ts",
        "tsConfig": "packages/integration/tsconfig.lib.json",
        "assets": ["packages/integration/*.md"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config packages/integration/eslint.config.js packages/integration"
      }
    }
  }
}
