{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use.js"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash.js"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use.js"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-bash.js"]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(yarn nx lint*)",
      "Bash(yarn nx test*)",
      "Bash(yarn nx build*)",
      "Bash(yarn nx serve*)",
      "Bash(yarn nx storybook*)",
      "Bash(yarn format*)",
      "Bash(yarn format:check*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(yarn prettier*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git * commit *)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr reopen *)"
    ]
  }
}
